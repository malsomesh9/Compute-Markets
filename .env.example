# Configure through InsForge CLI, never commit actual keys.
INSFORGE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
SOLANA_NETWORK=localnet
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
RUN_INDEXER=false
PUBLIC_READ_ONLY=false
# Highest verification policy accepted by the deployed program (0-5).
MAX_ONCHAIN_POLICY=5
RELEASE_GPU_QUALIFIED=false
RELEASE_TEE_QUALIFIED=false
RELEASE_PROOF_QUALIFIED=false
RELEASE_PERMISSIONLESS_VERIFIERS=false
RELEASE_OPERATIONS_QUALIFIED=false
RELEASE_AUDITED=false
MOCK_EXECUTOR=false
# Use runsc only after gVisor is installed and registered with Docker.
OCI_RUNTIME=runc
