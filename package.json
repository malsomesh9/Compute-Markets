{
  "name": "vericompute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm run dev -w apps/web\" \"npm run dev:api\"",
    "dev:api": "tsx --env-file=.env.local apps/api/src/main.ts",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "test": "tsx --test tests/*.test.ts",
    "test:chain": "tsx --env-file=.env.local tests/chain.e2e.ts",
    "indexer": "tsx --env-file=.env.local apps/indexer/src/main.ts",
    "license:audit": "tsx scripts/license-audit.ts",
    "sync:idl": "mkdir -p idl && cp target/idl/compute_market.json idl/compute_market.json",
    "worker": "tsx --env-file=.env.local agents/provider-node/daemon.ts",
    "verifier": "tsx --env-file=.env.local apps/verifier/src/daemon.ts",
    "mcp": "tsx --env-file=.env.local apps/gateway/src/mcp.ts",
    "test:backend": "tsx --env-file=.env.local tests/backend.integration.ts",
    "test:backend:auth": "tsx --env-file=.env.local tests/backend.auth.integration.ts",
    "test:policy": "opa test infra/policy -v",
    "test:cpu": "sh scripts/docker-test.sh tsx --env-file=.env.local tests/chain.cpu.e2e.ts",
    "test:gvisor": "OCI_RUNTIME=runsc sh scripts/docker-test.sh tsx --env-file=.env.local tests/chain.cpu.e2e.ts",
    "test:recovery": "sh scripts/docker-test.sh tsx --env-file=.env.local tests/docker.recovery.integration.ts",
    "test:management": "tsx --env-file=.env.local tests/protocol-management.e2e.ts",
    "test:agent-policy": "tsx --env-file=.env.local tests/agent-policy.e2e.ts",
    "test:verifier-recovery": "tsx --env-file=.env.local tests/verifier-recovery.integration.ts",
    "deploy:devnet": "bash scripts/deploy-devnet.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@fastify/cors": "latest",
    "@fastify/rate-limit": "latest",
    "@insforge/sdk": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "@opentelemetry/api": "latest",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@solana/kit": "8.2.0",
    "@solana/spl-token": "latest",
    "bs58": "latest",
    "canonicalize": "latest",
    "fastify": "latest",
    "prom-client": "^15.1.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "concurrently": "latest",
    "prettier": "^3.9.6",
    "tsx": "latest",
    "typescript": "latest"
  }
}
